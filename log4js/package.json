{
  "name": "log4js",
  "title": "Log4js - The Logging API for JavaScript",
  "description": "Modern TypeScript Logging Framework for JavaScript",
  "version": "3.0.0",
  "type": "module",
  "main": "./dist/log4js.umd.js",
  "module": "./dist/log4js.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/log4js.js",
      "require": "./dist/log4js.umd.js"
    }
  },
  "files": [
    "dist",
    "src/main/ts"
  ],
  "authors": [
    "stritti (https://github.com/stritti)"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src/main/ts --ext .ts",
    "lint:fix": "eslint src/main/ts --ext .ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stritti/log4js.git"
  },
  "keywords": [
    "log",
    "logging",
    "logger",
    "log4js",
    "log4j",
    "typescript",
    "modern",
    "es2022"
  ],
  "license": "Apache-2.0",
  "homepage": "http://stritti.github.io/log4js/",
  "bugs": {
    "url": "https://github.com/stritti/log4js/issues"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitest/ui": "^1.2.1",
    "eslint": "^8.56.0",
    "jsdom": "^24.1.3",
    "terser": "^5.27.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-dts": "^3.7.2",
    "vitest": "^1.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
